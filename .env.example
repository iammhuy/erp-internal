# Copy thành .env rồi sửa:  cp .env.example .env && nano .env
# --- Database ---
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=Huycuong@123
PGDATA_DIR=/srv/erp/pgdata
# --- Web ---
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai   # openssl rand -hex 32
COOKIE_SECURE=false                          # đổi true khi lên HTTPS
HTTP_PORT=80
# --- Tài khoản admin đầu tiên (chỉ tạo khi bảng nhân viên còn trống) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Huycuong@123
# --- Đồng bộ AWS (để trống nếu chưa dùng) ---
AWS_API_URL=
AWS_API_KEY=
SYNC_INTERVAL=20
